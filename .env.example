# ── Secrets required at runtime ───────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All database/cache services are provided by Docker containers — no external
# cloud accounts needed for MongoDB, PostgreSQL, or Redis.

# JSON Web Token secret — generate a long random string
JWT_SEC=your_jwt_secret_here

# Cloudinary — required for audio/image uploads in admin-service.
# Create a free account at https://cloudinary.com
Cloud_Name=your_cloudinary_cloud_name
Cloud_Api_Key=your_cloudinary_api_key
Cloud_Scret_Key=your_cloudinary_api_secret
